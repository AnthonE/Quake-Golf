;; xorshift32 on the header's PRNG word. Only serial phases may call it.
(func $rand (result i32)
  (local $x i32)
  (local.set $x (i32.load (i32.const @HDR_RNG)))
  (local.set $x (i32.xor (local.get $x) (i32.shl (local.get $x) (i32.const 13))))
  (local.set $x (i32.xor (local.get $x) (i32.shr_u (local.get $x) (i32.const 17))))
  (local.set $x (i32.xor (local.get $x) (i32.shl (local.get $x) (i32.const 5))))
  (i32.store (i32.const @HDR_RNG) (local.get $x))
  (local.get $x))

;; Uniform in [-1, 1).
(func $randf (result f32)
  (f32.mul (f32.convert_i32_s (call $rand)) (f32.const 0x1p-31)))

;; Sine and cosine of u/16384 of a turn (only the low 14 bits count): a
;; quadrant from the top two bits, then Taylor series on [0, pi/2) from add
;; and multiply only, so every engine gets the same bits.
(func $sincos (export "sincos") (param $u i32) (result f32 f32)
  (local $q i32) (local $x f32) (local $x2 f32) (local $s f32) (local $c f32)
  (local.set $q (i32.and (i32.shr_u (local.get $u) (i32.const 12)) (i32.const 3)))
  (local.set $x (f32.mul (f32.convert_i32_u (i32.and (local.get $u) (i32.const 4095))) (f32.const 0.00038349519697141)))
  (local.set $x2 (f32.mul (local.get $x) (local.get $x)))
  (local.set $s (f32.mul (local.get $x)
    (!madd (local.get $x2)
      (!madd (local.get $x2)
        (!madd (local.get $x2)
          (!madd (local.get $x2)
            (!madd (local.get $x2) (f32.const -2.505210839e-8) (f32.const 2.755731922e-6))
            (f32.const -1.984126984e-4))
          (f32.const 8.333333333e-3))
        (f32.const -0.1666666667))
      (f32.const 1))))
  (local.set $c
    (!madd (local.get $x2)
      (!madd (local.get $x2)
        (!madd (local.get $x2)
          (!madd (local.get $x2)
            (!madd (local.get $x2)
              (!madd (local.get $x2) (f32.const 2.087675699e-9) (f32.const -2.755731922e-7))
              (f32.const 2.480158730e-5))
            (f32.const -1.388888889e-3))
          (f32.const 4.166666667e-2))
        (f32.const -0.5))
      (f32.const 1)))
  ;; quadrants 0..3: (s, c), (c, -s), (-s, -c), (-c, s)
  (select (select (local.get $s) (local.get $c) (i32.eqz (i32.and (local.get $q) (i32.const 1))))
          (f32.neg (select (local.get $s) (local.get $c) (i32.eqz (i32.and (local.get $q) (i32.const 1)))))
          (i32.lt_u (local.get $q) (i32.const 2)))
  (select (select (local.get $c) (local.get $s) (i32.eqz (i32.and (local.get $q) (i32.const 1))))
          (f32.neg (select (local.get $c) (local.get $s) (i32.eqz (i32.and (local.get $q) (i32.const 1)))))
          (i32.eqz (i32.and (i32.add (local.get $q) (i32.const 1)) (i32.const 2)))))

;; murmur3's finaliser over a lattice point and a seed.
(func $hash32 (param $x i32) (param $z i32) (param $s i32) (result i32)
  (local $h i32)
  (local.set $h (i32.xor (i32.xor (i32.mul (local.get $x) (i32.const 0x27d4eb2d))
                                  (i32.mul (local.get $z) (i32.const 0x165667b1)))
                         (local.get $s)))
  (local.set $h (i32.xor (local.get $h) (i32.shr_u (local.get $h) (i32.const 15))))
  (local.set $h (i32.mul (local.get $h) (i32.const 0x85ebca6b)))
  (local.set $h (i32.xor (local.get $h) (i32.shr_u (local.get $h) (i32.const 13))))
  (local.set $h (i32.mul (local.get $h) (i32.const 0xc2b2ae35)))
  (i32.xor (local.get $h) (i32.shr_u (local.get $h) (i32.const 16))))

;; Ground under (x, z): height, unit normal, surface type.
(func $ground (param $x f32) (param $z f32) (result f32 f32 f32 f32 i32)
  (local $gx f32) (local $gz f32) (local $ix i32) (local $iz i32) (local $fx f32) (local $fz f32)
  (local $k i32) (local $h00 f32) (local $h10 f32) (local $h01 f32) (local $h11 f32)
  (local $ax f32) (local $az f32) (local $inv f32)
  (local.set $gx (!clamp (f32.mul (local.get $x) (f32.const 0.5)) (f32.const 0) (f32.const 510.99)))
  (local.set $gz (!clamp (f32.mul (local.get $z) (f32.const 0.5)) (f32.const 0) (f32.const 510.99)))
  (local.set $ix (i32.trunc_sat_f32_s (local.get $gx)))
  (local.set $iz (i32.trunc_sat_f32_s (local.get $gz)))
  (local.set $fx (f32.sub (local.get $gx) (f32.convert_i32_s (local.get $ix))))
  (local.set $fz (f32.sub (local.get $gz) (f32.convert_i32_s (local.get $iz))))
  (local.set $k (i32.add (i32.shl (local.get $iz) (i32.const 9)) (local.get $ix)))
  (local.set $h00 (f32.mul (f32.convert_i32_u (!ld u16 @TERRAIN_H (local.get $k))) (f32.const 0.00390625)))
  (local.set $h10 (f32.mul (f32.convert_i32_u (!ld u16 @(TERRAIN_H + 2) (local.get $k))) (f32.const 0.00390625)))
  (local.set $h01 (f32.mul (f32.convert_i32_u (!ld u16 @(TERRAIN_H + 1024) (local.get $k))) (f32.const 0.00390625)))
  (local.set $h11 (f32.mul (f32.convert_i32_u (!ld u16 @(TERRAIN_H + 1026) (local.get $k))) (f32.const 0.00390625)))
  ;; slopes per metre (samples are 2 m apart)
  (local.set $ax (f32.mul (f32.add (f32.mul (f32.sub (local.get $h10) (local.get $h00)) (f32.sub (f32.const 1) (local.get $fz)))
                                   (f32.mul (f32.sub (local.get $h11) (local.get $h01)) (local.get $fz)))
                          (f32.const 0.5)))
  (local.set $az (f32.mul (f32.add (f32.mul (f32.sub (local.get $h01) (local.get $h00)) (f32.sub (f32.const 1) (local.get $fx)))
                                   (f32.mul (f32.sub (local.get $h11) (local.get $h10)) (local.get $fx)))
                          (f32.const 0.5)))
  (local.set $inv (f32.div (f32.const 1)
                           (f32.sqrt (f32.add (f32.add (f32.mul (local.get $ax) (local.get $ax)) (f32.const 1))
                                              (f32.mul (local.get $az) (local.get $az))))))
  ;; bilinear height
  (f32.add (f32.add (f32.add (local.get $h00)
                             (f32.mul (f32.sub (local.get $h10) (local.get $h00)) (local.get $fx)))
                    (f32.mul (f32.sub (local.get $h01) (local.get $h00)) (local.get $fz)))
           (f32.mul (f32.mul (f32.add (f32.sub (f32.sub (local.get $h00) (local.get $h10)) (local.get $h01)) (local.get $h11))
                             (local.get $fx))
                    (local.get $fz)))
  (f32.neg (f32.mul (local.get $ax) (local.get $inv)))
  (local.get $inv)
  (f32.neg (f32.mul (local.get $az) (local.get $inv)))
  (!ld u8 @TERRAIN_S (local.get $k)))

#if DEBUG
;; Rule 5: no NaN or infinity in state. Records where and traps.
(func $assert_finite (param $v f32) (param $code i32) (param $idx i32)
  (if (i32.eqz (f32.lt (f32.abs (local.get $v)) (f32.const inf)))
    (then
      (i32.store (i32.const @ERR_CODE) (local.get $code))
      (i32.store (i32.const @ERR_INDEX) (local.get $idx))
      (i32.store (i32.const @ERR_TICK) (i32.load (i32.const @HDR_TICK)))
      (unreachable))))
#endif
