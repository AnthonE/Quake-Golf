;; 512 x 512 heightfield from one 32-bit seed, integer value noise only,
;; so every machine builds the same bytes. Heights in 1/256 m.

(func $val (param $lx i32) (param $lz i32) (param $s i32) (param $amp i32) (result i32)
  (i32.shr_u (i32.mul (i32.and (call $hash32 (local.get $lx) (local.get $lz) (local.get $s)) (i32.const 0xffff))
                      (local.get $amp))
             (i32.const 16)))

(func $terrain_gen (param $seed i32)
  (local $x i32) (local $z i32) (local $h i32) (local $k i32) (local $s i32)
  (local $lx i32) (local $lz i32) (local $fx i32) (local $fz i32)
  (!for $z (i32.const 0) (i32.const @GRID)
    (!for $x (i32.const 0) (i32.const @GRID)
      (local.set $h (i32.const 4096))
      (!octave 7 8192 1)
      (!octave 6 4096 2)
      (!octave 5 2048 3)
      (!octave 4 1024 4)
      (!octave 3 512 5)
      (local.set $k (i32.add (i32.shl (local.get $z) (i32.const 9)) (local.get $x)))
      (!st u16 @TERRAIN_H (local.get $k) (local.get $h))
      ;; surface: fairway, rough, sand, green, in 32 m patches
      (!st u8 @TERRAIN_S (local.get $k)
        (i32.and (call $hash32 (i32.shr_u (local.get $x) (i32.const 4)) (i32.shr_u (local.get $z) (i32.const 4))
                               (i32.xor (local.get $seed) (i32.const 0x5bd1e995)))
                 (i32.const 3))))))

;; One hole on the heightfield: tee and cup from the seed, then fairway, rough,
;; sand and green painted around them, and the tee box and green flattened.
;; Runs once at init, after $terrain_gen; floats are fine here (no sqrt
;; ordering or library calls), and the result is stored, so it is hashed.
(func $course_gen (param $seed i32)
  (local $tx f32) (local $tz f32) (local $cx f32) (local $cz f32) (local $dx f32) (local $dz f32)
  (local $dist f32) (local $s f32) (local $c f32) (local $ht f32) (local $hc f32)
  (local $x i32) (local $z i32) (local $k i32) (local $wx f32) (local $wz f32)
  (local $along f32) (local $px f32) (local $pz f32) (local $dseg f32) (local $dcup f32) (local $dtee f32)
  (local $half f32) (local $surf i32) (local $h f32) (local $t f32) (local $keep f32)
  (local $b0x f32) (local $b0z f32) (local $b1x f32) (local $b1z f32) (local $b2x f32) (local $b2z f32)
  (local $side f32)
  ;; tee somewhere in the middle 704 m, cup 160..300 m away; a cup off the
  ;; course flips that axis of the direction (the tee is far enough from the edge)
  (local.set $tx (f32.convert_i32_u (i32.add (i32.const 160) (i32.rem_u (call $hash32 (i32.const 1) (i32.const 2) (local.get $seed)) (i32.const 704)))))
  (local.set $tz (f32.convert_i32_u (i32.add (i32.const 160) (i32.rem_u (call $hash32 (i32.const 3) (i32.const 4) (local.get $seed)) (i32.const 704)))))
  (local.set $dist (f32.convert_i32_u (i32.add (i32.const 160) (i32.rem_u (call $hash32 (i32.const 5) (i32.const 6) (local.get $seed)) (i32.const 141)))))
  (call $sincos (call $hash32 (i32.const 7) (i32.const 8) (local.get $seed)))
  (local.set $c) (local.set $s)
  (local.set $dx (local.get $c))
  (local.set $dz (local.get $s))
  (local.set $cx (!madd (local.get $dx) (local.get $dist) (local.get $tx)))
  (if (i32.or (f32.lt (local.get $cx) (f32.const 120)) (f32.gt (local.get $cx) (f32.const 904)))
    (then (local.set $dx (f32.neg (local.get $dx))) (local.set $cx (!madd (local.get $dx) (local.get $dist) (local.get $tx)))))
  (local.set $cz (!madd (local.get $dz) (local.get $dist) (local.get $tz)))
  (if (i32.or (f32.lt (local.get $cz) (f32.const 120)) (f32.gt (local.get $cz) (f32.const 904)))
    (then (local.set $dz (f32.neg (local.get $dz))) (local.set $cz (!madd (local.get $dz) (local.get $dist) (local.get $tz)))))
  ;; bunkers: two flanking the green, one beside the fairway past halfway
  (local.set $side (select (f32.const 1) (f32.const -1) (i32.and (local.get $seed) (i32.const 1))))
  (local.set $b0x (f32.add (local.get $cx) (f32.mul (f32.add (f32.mul (local.get $dz) (f32.const 19)) (f32.mul (local.get $dx) (f32.const 6))) (local.get $side))))
  (local.set $b0z (f32.add (local.get $cz) (f32.mul (f32.sub (f32.mul (local.get $dz) (f32.const 6)) (f32.mul (local.get $dx) (f32.const 19))) (local.get $side))))
  (local.set $b1x (f32.sub (f32.sub (local.get $cx) (f32.mul (local.get $dz) (f32.mul (f32.const 17) (local.get $side)))) (f32.mul (local.get $dx) (f32.const 9))))
  (local.set $b1z (f32.sub (f32.add (local.get $cz) (f32.mul (local.get $dx) (f32.mul (f32.const 17) (local.get $side)))) (f32.mul (local.get $dz) (f32.const 9))))
  (local.set $b2x (f32.add (!madd (local.get $dx) (f32.mul (local.get $dist) (f32.const 0.6)) (local.get $tx)) (f32.mul (local.get $dz) (f32.mul (f32.const 18) (local.get $side)))))
  (local.set $b2z (f32.sub (!madd (local.get $dz) (f32.mul (local.get $dist) (f32.const 0.6)) (local.get $tz)) (f32.mul (local.get $dx) (f32.mul (f32.const 18) (local.get $side)))))
  ;; flatten towards the heights under the tee and the cup, read before any change
  (local.set $ht (f32.convert_i32_u (!ld u16 @TERRAIN_H (i32.add (i32.shl (i32.trunc_sat_f32_u (f32.mul (local.get $tz) (f32.const 0.5))) (i32.const 9))
                                                                (i32.trunc_sat_f32_u (f32.mul (local.get $tx) (f32.const 0.5)))))))
  (local.set $hc (f32.convert_i32_u (!ld u16 @TERRAIN_H (i32.add (i32.shl (i32.trunc_sat_f32_u (f32.mul (local.get $cz) (f32.const 0.5))) (i32.const 9))
                                                                (i32.trunc_sat_f32_u (f32.mul (local.get $cx) (f32.const 0.5)))))))
  (!for $z (i32.const 0) (i32.const @GRID)
    (!for $x (i32.const 0) (i32.const @GRID)
      (local.set $k (i32.add (i32.shl (local.get $z) (i32.const 9)) (local.get $x)))
      (local.set $wx (f32.convert_i32_u (i32.shl (local.get $x) (i32.const 1))))
      (local.set $wz (f32.convert_i32_u (i32.shl (local.get $z) (i32.const 1))))
      (local.set $along (!clamp (!dot3 (f32.sub (local.get $wx) (local.get $tx)) (f32.const 0) (f32.sub (local.get $wz) (local.get $tz))
                                       (local.get $dx) (f32.const 0) (local.get $dz))
                                (f32.const 0) (local.get $dist)))
      (local.set $px (f32.sub (local.get $wx) (!madd (local.get $dx) (local.get $along) (local.get $tx))))
      (local.set $pz (f32.sub (local.get $wz) (!madd (local.get $dz) (local.get $along) (local.get $tz))))
      (local.set $dseg (f32.sqrt (f32.add (f32.mul (local.get $px) (local.get $px)) (f32.mul (local.get $pz) (local.get $pz)))))
      (local.set $dcup (call $dist2d (local.get $wx) (local.get $wz) (local.get $cx) (local.get $cz)))
      (local.set $dtee (call $dist2d (local.get $wx) (local.get $wz) (local.get $tx) (local.get $tz)))
      ;; the fairway breathes between 9 and 17 m half-width along its length
      (call $sincos (i32.trunc_sat_f32_u (f32.mul (local.get $along) (f32.const 90))))
      (drop)
      (local.set $t)
      (local.set $half (!madd (local.get $t) (f32.const 4) (f32.const 13)))
      (local.set $surf (i32.const 1))
      (if (i32.or (f32.lt (local.get $dseg) (local.get $half)) (f32.lt (local.get $dtee) (f32.const @TEE_R)))
        (then (local.set $surf (i32.const 0))))
      (if (i32.or (i32.or (f32.lt (call $dist2d (local.get $wx) (local.get $wz) (local.get $b0x) (local.get $b0z)) (f32.const 6))
                          (f32.lt (call $dist2d (local.get $wx) (local.get $wz) (local.get $b1x) (local.get $b1z)) (f32.const 5)))
                  (f32.lt (call $dist2d (local.get $wx) (local.get $wz) (local.get $b2x) (local.get $b2z)) (f32.const 7)))
        (then (local.set $surf (i32.const 2))))
      (if (f32.lt (local.get $dcup) (f32.const @GREEN_R)) (then (local.set $surf (i32.const 3))))
      (!st u8 @TERRAIN_S (local.get $k) (local.get $surf))
      (local.set $h (f32.convert_i32_u (!ld u16 @TERRAIN_H (local.get $k))))
      ;; keep 3% of the relief on the green, none on the tee, blending out over 8 m
      (local.set $t (!clamp (f32.mul (f32.sub (local.get $dcup) (f32.const @GREEN_R)) (f32.const 0.125)) (f32.const 0) (f32.const 1)))
      (local.set $keep (!madd (f32.mul (local.get $t) (local.get $t)) (f32.const 0.97) (f32.const 0.03)))
      (local.set $h (!madd (f32.sub (local.get $h) (local.get $hc)) (local.get $keep) (local.get $hc)))
      (local.set $t (!clamp (f32.mul (f32.sub (local.get $dtee) (f32.const @TEE_R)) (f32.const 0.125)) (f32.const 0) (f32.const 1)))
      (local.set $h (!madd (f32.sub (local.get $h) (local.get $ht)) (f32.mul (local.get $t) (local.get $t)) (local.get $ht)))
      (!st u16 @TERRAIN_H (local.get $k) (i32.trunc_sat_f32_u (f32.add (local.get $h) (f32.const 0.5))))))
  (f32.store (i32.const @HDR_TEE) (local.get $tx))
  (f32.store (i32.const @(HDR_TEE + 8)) (local.get $tz))
  (f32.store (i32.const @HDR_CUP) (local.get $cx))
  (f32.store (i32.const @(HDR_CUP + 8)) (local.get $cz))
  (call $ground (local.get $tx) (local.get $tz))
  (drop) (drop) (drop) (drop)
  (local.set $h)
  (f32.store (i32.const @(HDR_TEE + 4)) (local.get $h))
  (call $ground (local.get $cx) (local.get $cz))
  (drop) (drop) (drop) (drop)
  (local.set $h)
  (f32.store (i32.const @(HDR_CUP + 4)) (local.get $h))
  (f32.store (i32.const @HDR_DIR) (local.get $dx))
  (f32.store (i32.const @(HDR_DIR + 4)) (local.get $dz))
  (i32.store (i32.const @HDR_PAR) (select (i32.const 3) (i32.const 4) (f32.lt (local.get $dist) (f32.const 220)))))

(func $dist2d (param $ax f32) (param $az f32) (param $bx f32) (param $bz f32) (result f32)
  (local $dx f32) (local $dz f32)
  (local.set $dx (f32.sub (local.get $ax) (local.get $bx)))
  (local.set $dz (f32.sub (local.get $az) (local.get $bz)))
  (f32.sqrt (f32.add (f32.mul (local.get $dx) (local.get $dx)) (f32.mul (local.get $dz) (local.get $dz)))))
