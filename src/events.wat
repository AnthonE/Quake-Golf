;; Quantized events from the inbox, applied in log order at the start of a tick.
;; Record (16 B): u32 tick | u8 kind | u8 a | u16 b | u16 x | i16 y | u16 z | i16 c
;; Positions in 1/64 m; y is height above the ground. Player records use a for
;; the slot, and an input record carries its u32 word at offset 8.

(func $apply_events
  (local $n i32) (local $k i32) (local $r i32) (local $kind i32)
  (local.set $n (i32.load (i32.const @INBOX)))
  (!for $k (i32.const 0) (local.get $n)
    (local.set $r (i32.add (i32.const @INBOX_REC) (i32.shl (local.get $k) (i32.const 4))))
    (local.set $kind (i32.load8_u offset=4 (local.get $r)))
    (if (i32.eq (local.get $kind) (i32.const @EV_SPAWN)) (then (call $ev_spawn (local.get $r))))
    (if (i32.eq (local.get $kind) (i32.const @EV_EXPLODE)) (then (call $ev_explode (local.get $r))))
    (if (i32.eq (local.get $kind) (i32.const @EV_EXPLODE_BALL)) (then (call $ev_explode_ball (local.get $r))))
    (if (i32.eq (local.get $kind) (i32.const @EV_INPUT)) (then (call $ev_input (local.get $r))))
    (if (i32.eq (local.get $kind) (i32.const @EV_JOIN)) (then (call $ev_join (local.get $r))))
    (if (i32.eq (local.get $kind) (i32.const @EV_LEAVE)) (then (call $ev_leave (local.get $r)))))
  (i32.store (i32.const @INBOX) (i32.const 0)))

;; A live player's input word for this tick; it stays until the next one.
(func $ev_input (param $r i32)
  (local $pb i32)
  (local.set $pb (i32.shl (i32.load8_u offset=5 (local.get $r)) (i32.const 6)))
  (if (i32.and (!at u8 @(PLAYERS + P_FL) (local.get $pb)) (i32.const @PF_LIVE))
    (then (!put i32 @(PLAYERS + P_IN) (local.get $pb) (i32.load offset=8 (local.get $r))))))

(func $ev_join (param $r i32)
  (local $p i32) (local $pb i32)
  (local.set $p (i32.load8_u offset=5 (local.get $r)))
  (local.set $pb (i32.shl (local.get $p) (i32.const 6)))
  (if (i32.and (!at u8 @(PLAYERS + P_FL) (local.get $pb)) (i32.const @PF_LIVE)) (then (return)))
  (memory.fill (i32.add (i32.const @PLAYERS) (local.get $pb)) (i32.const 0) (i32.const @PSIZE))
  (!put u8 @(PLAYERS + P_FL) (local.get $pb) (i32.const @PF_LIVE))
  ;; a join during the scoreboard gets its ball at the restart
  (call $to_tee (local.get $p) (i32.ne (i32.load (i32.const @HDR_STATE)) (i32.const @H_OVER)))
  (if (i32.eq (i32.load (i32.const @HDR_STATE)) (i32.const @H_IDLE))
    (then
      (i32.store (i32.const @HDR_STATE) (i32.const @H_COUNT))
      (i32.store (i32.const @HDR_UNTIL) (i32.add (i32.load (i32.const @HDR_TICK)) (i32.const @COUNT_TICKS))))))

;; The player goes; their ball stays where it lies.
(func $ev_leave (param $r i32)
  (local $pb i32)
  (local.set $pb (i32.shl (i32.load8_u offset=5 (local.get $r)) (i32.const 6)))
  (!put u8 @(PLAYERS + P_FL) (local.get $pb) (i32.const 0)))

;; A burst of `a` balls on a 4 x 4 lattice, owner `b`, speed c/64 m/s.
(func $ev_spawn (param $r i32)
  (local $count i32) (local $owner i32) (local $n i32) (local $m i32)
  (local $cx f32) (local $cy f32) (local $cz f32) (local $speed f32)
  (local $px f32) (local $py f32) (local $pz f32) (local $dx f32) (local $dy f32) (local $dz f32)
  (local.set $count (i32.load8_u offset=5 (local.get $r)))
  (local.set $owner (i32.load16_u offset=6 (local.get $r)))
  (local.set $cx (f32.mul (f32.convert_i32_u (i32.load16_u offset=8 (local.get $r))) (f32.const 0.015625)))
  (local.set $cz (f32.mul (f32.convert_i32_u (i32.load16_u offset=12 (local.get $r))) (f32.const 0.015625)))
  (local.set $cx (!clamp (local.get $cx) (f32.const 8) (f32.const 1016)))
  (local.set $cz (!clamp (local.get $cz) (f32.const 8) (f32.const 1016)))
  (call $ground (local.get $cx) (local.get $cz))
  (drop) (drop) (drop) (drop)
  (local.set $cy)
  (local.set $cy (f32.add (f32.add (local.get $cy) (f32.const @R))
                          (f32.mul (f32.convert_i32_s (i32.load16_s offset=10 (local.get $r))) (f32.const 0.015625))))
  (local.set $speed (f32.mul (f32.convert_i32_s (i32.load16_s offset=14 (local.get $r))) (f32.const 0.015625)))
  (local.set $n (i32.load (i32.const @HDR_NBALLS)))
  (block $full
    (!for $m (i32.const 0) (local.get $count)
      (br_if $full (i32.ge_u (local.get $n) (i32.const @BALL_CAP)))
      (local.set $px (f32.add (local.get $cx)
        (f32.mul (f32.sub (f32.convert_i32_u (i32.and (local.get $m) (i32.const 3))) (f32.const 1.5)) (f32.const 0.44))))
      (local.set $pz (f32.add (local.get $cz)
        (f32.mul (f32.sub (f32.convert_i32_u (i32.and (i32.shr_u (local.get $m) (i32.const 2)) (i32.const 3))) (f32.const 1.5)) (f32.const 0.44))))
      (local.set $py (f32.add (local.get $cy)
        (f32.mul (f32.convert_i32_u (i32.shr_u (local.get $m) (i32.const 4))) (f32.const 0.44))))
      (local.set $dx (call $randf))
      (local.set $dy (call $randf))
      (local.set $dz (call $randf))
      (!st f32 @PX (local.get $n) (local.get $px))
      (!st f32 @PY (local.get $n) (local.get $py))
      (!st f32 @PZ (local.get $n) (local.get $pz))
      (!st f32 @VX (local.get $n) (f32.mul (local.get $dx) (local.get $speed)))
      (!st f32 @VY (local.get $n) (f32.mul (f32.add (f32.mul (f32.abs (local.get $dy)) (f32.const 0.5)) (f32.const 0.5)) (local.get $speed)))
      (!st f32 @VZ (local.get $n) (f32.mul (local.get $dz) (local.get $speed)))
      (!st u8 @FLAGS (local.get $n) (i32.const @(F_LIVE | F_AWAKE)))
      (!st u8 @SLEEP (local.get $n) (i32.const 0))
      (!st u16 @OWNER (local.get $n) (local.get $owner))
      (!inc $n)))
  (i32.store (i32.const @HDR_NBALLS) (local.get $n)))

;; Strength s m/s at the centre, radius r m, linear falloff, on every ball in
;; play. Players get theirs from $blast_players.
(func $blast (param $cx f32) (param $cy f32) (param $cz f32) (param $s f32) (param $r f32)
  (local $n i32) (local $i i32) (local $dx f32) (local $dy f32) (local $dz f32)
  (local $d2 f32) (local $dist f32) (local $f f32) (local $r2 f32) (local $invr f32)
  (local.set $r2 (f32.mul (local.get $r) (local.get $r)))
  (local.set $invr (f32.div (f32.const 1) (f32.max (local.get $r) (f32.const 0.015625))))
  (local.set $n (i32.load (i32.const @HDR_NBALLS)))
  (!for $i (i32.const 0) (local.get $n)
    (local.set $dx (f32.sub (!ld f32 @PX (local.get $i)) (local.get $cx)))
    (local.set $dy (f32.sub (!ld f32 @PY (local.get $i)) (local.get $cy)))
    (local.set $dz (f32.sub (!ld f32 @PZ (local.get $i)) (local.get $cz)))
    (local.set $d2 (!dot3 (local.get $dx) (local.get $dy) (local.get $dz) (local.get $dx) (local.get $dy) (local.get $dz)))
    (if (i32.and (f32.lt (local.get $d2) (local.get $r2)) (i32.and (!ld u8 @FLAGS (local.get $i)) (i32.const @F_LIVE)))
      (then
        (local.set $dist (f32.sqrt (f32.max (local.get $d2) (f32.const 1e-6))))
        (local.set $f (f32.div (f32.mul (f32.sub (f32.const 1) (f32.mul (local.get $dist) (local.get $invr))) (local.get $s))
                               (local.get $dist)))
        (!st f32 @VX (local.get $i) (!madd (local.get $dx) (local.get $f) (!ld f32 @VX (local.get $i))))
        (!st f32 @VY (local.get $i) (!madd (local.get $dy) (local.get $f) (!ld f32 @VY (local.get $i))))
        (!st f32 @VZ (local.get $i) (!madd (local.get $dz) (local.get $f) (!ld f32 @VZ (local.get $i))))
        (!st u8 @FLAGS (local.get $i) (i32.or (!ld u8 @FLAGS (local.get $i)) (i32.const @F_AWAKE)))
        (!st u8 @SLEEP (local.get $i) (i32.const 0))))))

(func $ev_explode (param $r i32)
  (local $cx f32) (local $cy f32) (local $cz f32)
  (local.set $cx (f32.mul (f32.convert_i32_u (i32.load16_u offset=8 (local.get $r))) (f32.const 0.015625)))
  (local.set $cz (f32.mul (f32.convert_i32_u (i32.load16_u offset=12 (local.get $r))) (f32.const 0.015625)))
  (call $ground (local.get $cx) (local.get $cz))
  (drop) (drop) (drop) (drop)
  (local.set $cy)
  (call $blast (local.get $cx)
               (f32.add (local.get $cy) (f32.mul (f32.convert_i32_s (i32.load16_s offset=10 (local.get $r))) (f32.const 0.015625)))
               (local.get $cz)
               (f32.mul (f32.convert_i32_u (i32.load8_u offset=5 (local.get $r))) (f32.const 0.25))
               (f32.mul (f32.convert_i32_u (i32.load16_u offset=6 (local.get $r))) (f32.const 0.015625))))

;; Harness only: a blast centred on ball (c mod nballs), to keep pits stirred.
(func $ev_explode_ball (param $r i32)
  (local $n i32) (local $j i32)
  (local.set $n (i32.load (i32.const @HDR_NBALLS)))
  (if (i32.eqz (local.get $n)) (then (return)))
  (local.set $j (i32.rem_u (i32.load16_u offset=14 (local.get $r)) (local.get $n)))
  (call $blast (!ld f32 @PX (local.get $j)) (!ld f32 @PY (local.get $j)) (!ld f32 @PZ (local.get $j))
               (f32.mul (f32.convert_i32_u (i32.load8_u offset=5 (local.get $r))) (f32.const 0.25))
               (f32.mul (f32.convert_i32_u (i32.load16_u offset=6 (local.get $r))) (f32.const 0.015625))))
